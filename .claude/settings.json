{
  "permissions": {
    "allow": [
      "Edit(/cmd/**)",
      "Edit(/internal/**)",
      "Edit(/testdata/**)",
      "Edit(/docs/**)",
      "Edit(/.github/**)",
      "Edit(/go.mod)",
      "Edit(/go.sum)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go run *)",
      "Bash(go mod tidy)",
      "Bash(go mod download)",
      "Bash(go env *)",
      "Bash(go version)",
      "Bash(gofmt *)",
      "Bash(golangci-lint *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git worktree *)",
      "Bash(mkdir *)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(go get *)",
      "Bash(go install *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gofmt.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check.sh" }
        ]
      }
    ]
  }
}
